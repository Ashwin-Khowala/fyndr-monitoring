global:
  resolve_timeout: 5m
  # --- SMTP Configuration ---
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_AUTH_USERNAME}'
  smtp_auth_password: '${SMTP_AUTH_PASSWORD}'
  smtp_require_tls: true

# Route configuration
route:
  group_by: ['alertname', 'severity', 'service']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 12h
  receiver: 'default-receiver'
  
  # Child routes
  routes:
    - match:
        severity: critical
      receiver: 'critical-alerts'
      continue: true
    
    - match:
        severity: warning
      receiver: 'warning-alerts'

# Receivers configuration
receivers:
  - name: 'default-receiver'
    # Add your notification channels here
    
  - name: 'critical-alerts'
    email_configs:
      - to: '${ALERT_EMAIL_DESTINATION}'
        send_resolved: true
    
  - name: 'warning-alerts'
    email_configs:
      - to: '${ALERT_EMAIL_DESTINATION}'
        send_resolved: true

# Inhibition rules (prevent duplicate alerts)
inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
